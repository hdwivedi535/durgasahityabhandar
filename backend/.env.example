NODE_ENV=development
PORT=4000
# Local Docker: mongodb://localhost:27017/dsb
# MongoDB Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/dsb
MONGODB_URI=mongodb://localhost:27017/dsb
JWT_SECRET=change-me-access-secret-min-16
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
API_PATH_PREFIX=
COOKIE_SECURE=false
SEED_ADMIN_EMAIL=admin@dsb.local
SEED_ADMIN_PASSWORD=Admin@123456

# Phase 5 CRM AI — keep provider=none until a key and daily budget are approved.
# Do not set a real API key in this checkpoint.
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=15000
AI_DAILY_TOKEN_BUDGET=0
AI_MAX_OUTPUT_TOKENS=800
